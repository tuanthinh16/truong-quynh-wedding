# Updated 2026-11-14: admin authentication on local and Vercel; set your own password of at least 12 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Added 2026-11-13: SMTP for attendance guidance; server-only, never enter these secrets in the visual editor.
# Use port 587 with SMTP_SECURE=false (STARTTLS), or port 465 with SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=

# Added 2026-11-13: cap SMTP attempts across both sides; one email per recipient per side per UTC day.
RSVP_DAILY_EMAIL_LIMIT=100

# Added 2026-11-13: Gmail SMTP example. Set the existing keys above in .env.local, not in admin.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=your-16-character-google-app-password
# SMTP_FROM=your-account@gmail.com
# SMTP_REPLY_TO=your-account@gmail.com
# Sender display name is mail.senderName in the visual editor (default: Truong Quynh Wedding).

# Updated 2026-11-13: wedding.json is ignored; fresh builds bootstrap from wedding.defaults.json without replacing an existing runtime file.
# Online admin saves to the persistent Redis store below; only new image uploads remain local.
# RSVP uses temporary server storage; records and email quotas are not shared across instances.

# Added 2026-11-14: persistent online content and shared login throttling; server-only credentials, never NEXT_PUBLIC.
# Connect an Upstash Redis integration in Vercel, or set these two REST credentials in Vercel Environment Variables.
# Existing Vercel KV_REST_API_URL / KV_REST_API_TOKEN are also supported. Use a database without eviction for content.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Added 2026-11-14: keep this key stable across redeploys; use a different key/database for Preview deployments.
WEDDING_CONTENT_KEY=wedding:content:v1
