# Added 2026-11-13: local visual editor authentication; set your own password of at least 12 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Added 2026-11-13: SMTP for attendance guidance; server-only, never enter these secrets in the visual editor.
# Use port 587 with SMTP_SECURE=false (STARTTLS), or port 465 with SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=

# Added 2026-11-13: cap SMTP attempts across both sides; one email per recipient per side per UTC day.
RSVP_DAILY_EMAIL_LIMIT=100

# Added 2026-11-13: Gmail SMTP example. Set the existing keys above in .env.local, not in admin.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=your-16-character-google-app-password
# SMTP_FROM=your-account@gmail.com
# SMTP_REPLY_TO=your-account@gmail.com
# Sender display name is mail.senderName in the visual editor (default: Truong Quynh Wedding).

# Added 2026-11-13: Vercel serverless editor, private guest records and durable uploads. Create a PRIVATE Blob store.
# On Vercel set these in Project Settings > Environment Variables, then redeploy; .env.local is not deployed.
BLOB_READ_WRITE_TOKEN=
# Optional namespace; separate production and preview stores/prefixes. Default: wedding-${VERCEL_ENV || production}.
WEDDING_BLOB_PREFIX=
